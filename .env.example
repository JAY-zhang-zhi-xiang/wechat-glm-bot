# Required
ZHIPU_API_KEY=replace-with-your-zhipu-api-key
WECHAT_TOKEN=replace-with-your-wechat-token
ADMIN_TOKEN=
ENABLE_DOCS=false
ALLOW_ADMIN_TOKEN_QUERY=false
LOG_LEVEL=INFO

# Models. Keep these configurable because GLM model names may change.
TEXT_MODEL=glm-4-flash
VISION_MODEL=glm-4v-flash

# Assistant behavior
BOT_NAME=贾维斯
GLM_TIMEOUT_SECONDS=4
MODEL_MAX_TOKENS=800
MODEL_MAX_CONCURRENT_CALLS=4
MAX_REPLY_CHARS=650
MAX_MODEL_INPUT_CHARS=4000
SYSTEM_PROMPT=你是贾维斯，一个运行在微信里的中文智能助手。回答要可靠、简洁、友好。遇到不确定的信息要说明不确定，不要编造。
IMAGE_PROMPT=请用中文简洁分析这张微信图片。如果图片里有文字，也请尽量识别出来。

# Safety and retry controls
MAX_REQUEST_BYTES=65536
WECHAT_SIGNATURE_TOLERANCE_SECONDS=600
DUPLICATE_CACHE_TTL_SECONDS=300
DUPLICATE_CACHE_MAX_SIZE=1024
CONVERSATION_MEMORY_TTL_SECONDS=1800
CONVERSATION_MEMORY_MAX_TURNS=6
CONVERSATION_MEMORY_MAX_USERS=1024
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_MAX_USERS=2048

# Optional local keyword blocklist checked against the final model reply.
# Leave empty to disable content moderation entirely.
MODERATION_BLOCKLIST_FILE=

# Model call circuit breaker: opens after N failures within the window,
# then rejects calls for the cooldown period instead of hammering GLM.
MODEL_CIRCUIT_BREAKER_THRESHOLD=5
MODEL_CIRCUIT_BREAKER_WINDOW_SECONDS=60
MODEL_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Optional Feishu custom bot webhook for circuit-breaker alerts.
# Leave empty to disable alerting.
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL_SECONDS=300

# Required only for the WeChat access_token subsystem: customer service
# message fallback (ENABLE_CUSTOMER_SERVICE_FALLBACK) and
# scripts/setup_wechat_menu.py.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ENABLE_CUSTOMER_SERVICE_FALLBACK=false


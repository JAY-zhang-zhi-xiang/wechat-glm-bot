[Unit]
Description=WeChat GLM Assistant
After=network.target

[Service]
Type=simple
User=wechat-glm
WorkingDirectory=/opt/wechat-glm-assistant
Environment="PATH=/opt/wechat-glm-assistant/.venv/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/opt/wechat-glm-assistant/.env
ExecStart=/opt/wechat-glm-assistant/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
